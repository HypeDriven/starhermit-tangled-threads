{
  "name": "tangled-threads",
  "version": "1.0.0",
  "description": "Tangled Threads — route coloured strands without crossings and reel each into its spool. A routing puzzle on the StarHermit engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.js tests/save.test.mjs tests/i18n.test.mjs tests/server.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "start": "node server.cjs",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "textures": "node tools/bake-textures.mjs",
    "plays": "node tools/gen-plays.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
