# Generated by tools/gen-plays.mjs: the Learn board (First Stitches) by finger on the board mirror on a DPR-3 phone, the lesson steps checked.
# viewport 390x844@3
until 600 =Play
frames 30
touch =Play
until 300 Choose a mode
frames 10
touch Learn.
frames 10
touch =Start
until 300 Lesson 1/5
frames 30
# strand 1
touch =Strand 1 tip, row 1 column 1
frames 6
expect Lesson 2/5
touch =Empty cell, row 2 column 1
frames 6
expect Lesson 3/5
touch =Empty spool for strand 1, row 3 column 1
frames 6
expect Lesson 4/5
save learn-at-spool
touch =Strand 1 tip, on its spool, row 3 column 1
frames 8
expect Lesson 5/5
# strand 2
touch =Strand 2 tip, row 2 column 2
frames 6
touch =Empty cell, row 3 column 2
frames 6
touch =Empty spool for strand 2, row 3 column 3
frames 6
touch =Strand 2 tip, on its spool, row 3 column 3
frames 8
until 300 Total
frames 10
expect Board complete!
expect 6 moves (par 6) · 0 hints
expect =1800
save learn-results
touch =Home
until 300 =Play
