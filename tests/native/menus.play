# Generated by tools/gen-plays.mjs: the menus on a desktop: How to play, Settings from the title (left-handed tray on, then off), and today's Daily started and left.
# viewport 1280x800@1
until 600 =Play
frames 30
click =Help
until 300 No crossings.
save help
click =Close
until 300 =Play
frames 10
click =Settings
until 300 Left-handed controls
frames 10
click =Left-handed controls #2
frames 10
click =Left-handed controls #2
frames 10
save settings
click =Back
until 300 =Play
frames 10
click =Play
until 300 Choose a mode
frames 10
click Daily.
frames 10
click =Start
until 300 Reeled 0/
expect Daily 20
frames 30
key Escape 1
until 300 =Leave round
frames 10
click =Leave round
until 300 =Play
